# .env の見本。リポジトリの直下に .env としてコピーし、値を埋める（.env は git に入れない）

# Discord の bot のトークン（Developer Portal の Bot → Reset Token）
DISCORD_TOKEN=

# Tsukena の API のトークン。それぞれ次で作り、別々の値にする
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TSUKENA_APP_API_TOKEN=
TSUKENA_BOT_API_TOKEN=

# bot から見た API の場所。同じ機械で動かすなら省略してよい
# TSUKENA_API_BASE_URL=http://127.0.0.1:8000

# Gmail 連携で、Google が同意のあとに戻してくる先（→ docs/deploy.md 7）。
# Cloudflare Tunnel で外に出した API の URL に /oauth/google/callback を付けたもの。
# 空のままなら Gmail 連携のエンドポイントは 503 を返す
TSUKENA_GOOGLE_REDIRECT_URI=
